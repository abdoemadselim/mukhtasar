[Unit]
Description=Mukhtasar web
After=network.target mukhtasar-backend.service

[Service]
Type=simple
WorkingDirectory=/opt/mukhtasar/apps/frontend
Environment=NODE_ENV=production
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start -p 3002
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
