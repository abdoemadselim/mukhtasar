{
  "name": "@mukhtasar/backend",
  "version": "1.0.0",
  "type": "module",
  "homepage": "",
  "private": true,
  "imports": {
    "#root/*": "./dist/*",
    "#features/*": "./dist/features/*",
    "#lib/*": "./dist/lib/*",
    "#routes/*": "./dist/routes/*",
    "#middlewares/*": "./dist/middlewares/*"
  },
  "author": {
    "name": "Abdelrahman Emad",
    "email": "abdulrahman3mad@gmail.com",
    "url": "https://mukhtasar.pro"
  },
  "description": "Mokhtasar allows you to convert long unaccessible URL to short, neat URL",
  "engines": {
    "node": ">= 14.0.0",
    "npm": ">= 6.0.0"
  },
  "main": "./dist/main.js",
  "scripts": {
    "dev": "node --watch ./dist/main.js",
    "prepare": "husky",
    "watch": "tsc --watch && npm run copy-assets",
    "build": "rm -rf dist && tsc && npm run copy-assets",
    "migrate": "node-pg-migrate",
    "copy-assets": "cp -r ./src/lib/geo/*.mmdb dist/lib/geo/ || true",
    "migrate:up": "PGSSLMODE=require node-pg-migrate up",
    "migrate:down": "PGSSLMODE=require node-pg-migrate down"
  },
  "keywords": [
    "URL",
    "URI",
    "Short URL",
    "Long URL"
  ],
  "license": "MIT",
  "dependencies": {
    "@maxmind/geoip2-node": "^6.1.0",
    "@mukhtasar/shared": "workspace:*",
    "@sendgrid/mail": "^8.1.5",
    "bcrypt": "^6.0.0",
    "body-parser": "^2.2.0",
    "cloudflare": "^5.1.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "newrelic": "^13.1.0",
    "node-pg-migrate": "^8.0.3",
    "nodemailer": "^7.0.6",
    "pg": "^8.16.3",
    "rate-limit-redis": "^4.2.2",
    "redis": "^5.8.1",
    "swagger-ui-express": "^5.0.1",
    "ua-parser-js": "^2.0.4",
    "winston": "^3.17.0",
    "zod": "^4.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@faker-js/faker": "^10.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/body-parser": "^1.19.6",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/nodemailer": "^7.0.1",
    "@types/pg": "^8.15.5",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^9",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "jest": "^30.1.3",
    "jiti": "^2.5.1",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.43.0"
  }
}