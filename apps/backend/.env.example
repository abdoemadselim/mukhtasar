PORT = 3000

# LOCAL SECRETS
ORIGINAL_DOMAIN="localhost.com"
MACHINE_ID=01
AUTH_SESSION_NAME="mukhtasar-session"
WEB_URL="http://localhost:3000"
NODE_ENV="development"

# DB SECRETS

DB_PORT=5432

#-------- UPDATE THIS
DB_CONNECTION_STRING="postgres://abdelrahman:abdelrahman@localhost:5432/mukhtasar"
DATABASE_URL="postgres://abdelrahman:abdelrahman@localhost:5432/mukhtasar"
SESSION_DURATION=172800000 # 2 days

# REDIS SECRETS
#-------- UPDATE THIS TO YOUR REDIS CONNECTION CONFIG
REDIS_PASSWORD=""
REDIS_USER_NAME=""
REDIS_HOST=""
REDIS_PORT="14292"

# EMAIL SECRETS
#--------- ONLY REQUIRED FOR EMAIL VERIFICATION SERVICE
SENDGRID_API_KEY=""
EMAIL_VERIFICATION_SECRET_KEY=""

# WORKER SECRETS
#--------- ONLY REQUIRED FOR PRODUCTION (CLOUDFLARE WORKER)
WORKER_SECRET=""

# Self-hosted overrides
# DB_SSL=true when the database requires TLS
# PUBLIC_BASE_URL is the link visitors open, for example http://localhost:3002
# AUTO_VERIFY_USERS=true skips email verification when SMTP is not configured
# COOKIE_SECURE=false and an empty COOKIE_DOMAIN are for plain HTTP on an IP
# ALLOWED_ORIGINS is a comma-separated CORS list added to the built-in origins
# REDIS_DB selects a Redis logical database so this app can share a Redis server
DB_SSL=false
PUBLIC_BASE_URL=http://localhost:3002
AUTO_VERIFY_USERS=false
COOKIE_SECURE=false
COOKIE_DOMAIN=localhost
ALLOWED_ORIGINS=http://localhost:3002
REDIS_DB=0
PASSWORD_RESET_SECRET_KEY=""
ORIGINAL_URL=http://localhost:3002

# CLOUDFLARE (for custom domains / SaaS)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
FALLBACK_ORIGIN=domains.mukhtasar.site